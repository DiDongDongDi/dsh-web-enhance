{
    "name": "dsh-web-enhance",
  "version": "0.2.5",
  "description": "DSH Web GUI enhancements — session archive, #session= deep link, optional #prompt= draft prefill, keep workspace session lists expanded (Cordis plugin, no file patches).",
    "keywords": [
        "deepseek-harness",
        "dsh",
        "dsh-plugin",
        "cordis",
        "archive",
        "session",
        "web-ui"
    ],
    "license": "MIT",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "README.zh.md",
        "LICENSE"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "engines": {
        "node": ">=22"
    }
}
